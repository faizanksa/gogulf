{
  "name": "go-gulf",
  "version": "1.0.0",
  "private": true,
  "description": "Go Gulf — overseas recruitment platform website (Next.js, App Router).",
  "scripts": {
    "predev": "node scripts/check-staging-isolation.mjs --mode=development",
    "dev": "cross-env PLATFORM_MODE=server next dev",
    "dev:static": "next dev",
    "prebuild": "node scripts/check-staging-isolation.mjs",
    "build": "next build",
    "prebuild:server": "node scripts/check-staging-isolation.mjs",
    "build:server": "cross-env PLATFORM_MODE=server next build",
    "prebuild:production-stage": "node scripts/check-staging-isolation.mjs",
    "build:production-stage": "cross-env APP_ENV=production PLATFORM_MODE=server next build",
    "prestart": "node scripts/check-staging-isolation.mjs",
    "start": "cross-env PLATFORM_MODE=server next start",
    "env:local": "node scripts/use-local-supabase.mjs",
    "db:test": "node scripts/db-test-local.mjs",
    "db:seed:local": "node scripts/db-seed-local.mjs",
    "db:staging": "node scripts/db-remote.mjs --target=staging",
    "db:mumbai": "node scripts/db-remote.mjs --target=mumbai-staging",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "check:secrets": "node scripts/check-client-secrets.mjs",
    "check:all": "npm run lint && npm run typecheck && npm run test && npm run build && npm run build:server",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "perf:lighthouse": "node scripts/perf/lighthouse.mjs",
    "perf:inp": "node scripts/perf/inp.mjs",
    "perf:bundle": "node scripts/perf/bundle-report.mjs",
    "perf:axe-summary": "node scripts/perf/axe-summary.mjs",
    "analyze": "cross-env PLATFORM_MODE=server next experimental-analyze --output",
    "check:isolation": "node scripts/check-staging-isolation.mjs",
    "db:validate": "node scripts/validate-migrations.mjs",
    "backup:prod": "node scripts/backup-production.mjs",
    "restore": "node scripts/restore-backup.mjs",
    "bootstrap:admins": "node scripts/bootstrap-super-admins.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.112.1",
    "intl-messageformat": "10.7.18",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.26.0",
    "server-only": "^0.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "^5.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "lighthouse": "^13.4.1",
    "pgsql-parser": "^18.2.6",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "web-vitals": "^6.2.1"
  }
}
