# =============================================================================
# Go Gulf — environment template
#
# Copy to .env.local and fill in real values. .env.local is git-ignored.
# NEVER commit real credentials. NEVER paste a secret into a ticket or chat.
#
# THE ONE RULE THAT MATTERS
#   NEXT_PUBLIC_* is compiled into the JavaScript that ships to every visitor's
#   browser. Anything with that prefix is PUBLIC — permanently, to everyone.
#   A secret placed there is disclosed the moment the site is deployed.
#   If a value must stay private, it must NOT start with NEXT_PUBLIC_.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. PUBLIC — shipped to the browser by design. No secrets here, ever.
# -----------------------------------------------------------------------------

# Canonical site origin. Drives canonical URLs, Open Graph, JSON-LD, sitemap.
# Production defaults to https://www.gogulf.co when unset; set it for staging.
NEXT_PUBLIC_SITE_URL=

# Supabase project URL. Public — it appears in every browser request.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key. Public BY DESIGN: it carries no privileges of
# its own and every table it touches is bounded by Row Level Security.
# It is not a secret, but it is also not authorization — RLS is.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Razorpay key id. Required by Razorpay Checkout in the browser, so it is
# public. The SECRET half lives in section 2 and must never appear here.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Sentry DSN. Public by design — it identifies the project, it does not grant
# access to error data.
NEXT_PUBLIC_SENTRY_DSN=


# -----------------------------------------------------------------------------
# 2. SERVER-ONLY — secrets. Server Actions, Route Handlers and cron only.
#    None of these may ever be read from a Client Component, returned in an
#    API response, embedded in HTML, or logged.
# -----------------------------------------------------------------------------

# Supabase service role. BYPASSES ALL ROW LEVEL SECURITY.
# Permitted uses ONLY: verified webhooks, cron jobs, controlled migration
# tooling, system automation. NEVER for serving an ordinary customer or admin
# request — those use the caller's own authenticated session so RLS applies.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string. Migrations and CI only.
SUPABASE_DB_URL=

# Razorpay secret half. Signs orders and verifies webhook signatures.
RAZORPAY_KEY_SECRET=

# Razorpay webhook signing secret. HMAC-SHA256 over the RAW request body.
# Distinct from RAZORPAY_KEY_SECRET — set it in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=

# Resend transactional email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=
RESEND_WEBHOOK_SECRET=

# Authenticates Vercel Cron against /api/cron/* so the endpoints are not
# openly callable.
CRON_SECRET=

# Sentry source-map upload at build time.
SENTRY_AUTH_TOKEN=


# -----------------------------------------------------------------------------
# 3. THIRD-PARTY INTEGRATIONS — added as each phase lands.
#    Every one of these is server-only. Providers sit behind adapters
#    (lib/providers/*) so any of them can be swapped without touching
#    application code.
# -----------------------------------------------------------------------------

# --- OTP / SMS (Phase 3) ------------------------------------------------------
# Provider is pluggable: firebase | msg91 | twilio
# India DLT header + template registration must be complete before production
# SMS. It has weeks of lead time — see MIGRATION-PLAN.md.
OTP_PROVIDER=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# MSG91_AUTH_KEY=
# MSG91_DLT_TEMPLATE_ID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# --- WhatsApp Business Cloud API (Phase 9) ------------------------------------
# Official Meta Cloud API only. No unofficial browser automation.
# The production number is NOT yet chosen — see decision B7.
WHATSAPP_PROVIDER=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
# Validates the X-Hub-Signature-256 header on inbound webhooks.
WHATSAPP_APP_SECRET=
# Echoed back during Meta's webhook subscription handshake.
WHATSAPP_VERIFY_TOKEN=

# --- Telephony / IVR (Phase 10) -----------------------------------------------
# Provider pluggable: exotel | myoperator | knowlarity
TELEPHONY_PROVIDER=
TELEPHONY_API_KEY=
TELEPHONY_API_SECRET=
TELEPHONY_WEBHOOK_SECRET=

# --- Google Workspace SSO for staff (Phase 1) ---------------------------------
# Restricted to the gogulf.co hosted domain. Configured in Supabase Auth;
# listed here for completeness.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# 4. LEGACY — being retired. Do not add these to any new environment.
# -----------------------------------------------------------------------------

# EmailJS. Browser-side email, replaced by Resend in Phase 1.5.
# Removing these also requires updating the third-party processor list on
# /privacy-policy, which names EmailJS as a processor of form data.
# NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
# NEXT_PUBLIC_EMAILJS_SERVICE_ID=
# NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
