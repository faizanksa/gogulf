# dependencies
/node_modules

# next.js build output
/.next/
/out/

# Next build output (optional)
/build/

# Test runner output. Measurement summaries worth keeping live in perf/ (tracked).
/test-results/
/playwright-report/

# local env files (may contain secrets)
