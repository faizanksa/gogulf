# Copy this file to .env.local and fill in your real keys.
# .env.local is git-ignored — never commit real keys.

# Site URL — used to build canonical URLs, Open Graph/Twitter tags, JSON-LD
# and sitemap.xml/robots.txt at build time. Only needed if deploying to a
# domain other than https://www.gogulf.co (e.g. a staging preview URL).
# NEXT_PUBLIC_SITE_URL=https://www.gogulf.co

# Supabase — stores CV/passport/document uploads + the application record.
# Use the "anon" / "publishable" key ONLY — never the service_role/secret key,
# this file ends up in the browser bundle. See SUPABASE-SETUP.md.
#
# Local development uses the local stack, not a hosted project:
#
#   npx supabase start
#   npm run env:local
#
# Do NOT paste the production project here. An example file is copied to
# .env.local without much thought, and on 6 Sep 2026 that is precisely how this
# repository ended up developing against real candidate records and passport
# scans (docs/LEGACY-DATA-INSPECTION.md §15). scripts/check-staging-isolation.mjs
# now refuses to start or build in that state.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
