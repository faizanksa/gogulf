# Copy this file to .env.local and fill in your real keys.
# .env.local is git-ignored — never commit real keys.

# EmailJS — sends the notification + confirmation emails. See EMAILJS-SETUP.md.
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=

# Supabase — stores CV/passport/document uploads + the application record.
# Use the "anon" / "publishable" key ONLY — never the service_role/secret key,
# this file ends up in the browser bundle. See SUPABASE-SETUP.md.
NEXT_PUBLIC_SUPABASE_URL=https://julbqkeyvzwluayokcdi.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
